# Brihot Commerce storefront connection (public values, no secrets).
# Full API mount including its version prefix.
NEXT_PUBLIC_COMMERCE_API_URL=https://store-api.brihot.com/api/v1
# Restaurant store slug on Brihot. test-shoe is ONLY an SDK connectivity reference; never use it for restaurant content.
NEXT_PUBLIC_COMMERCE_STORE=plant-world-bd
# Catalog source: "store" (live Brihot store) or "fixtures" (local labelled preview data, ordering disabled).
NEXT_PUBLIC_CATALOG_SOURCE=store

# Merchant API key (private, required only for running scripts/seed-catalog.mjs)
COMMERCE_MERCHANT_KEY=ak_s_your_merchant_api_key_here
